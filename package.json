{
  "name": "ai-workflow-studio",
  "version": "2.2.0",
  "description": "AI工作流工作室 - Single-page AI workflow studio with Express + Socket.IO backend",
  "main": "server/index.js",
  "scripts": {
    "start": "npm run start:prod",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "dev": "cross-env NODE_ENV=development nodemon server/index.js",
    "build:frontend": "node scripts/generate-config.js",
    "validate:deploy": "node scripts/validate-split-deploy.js"
