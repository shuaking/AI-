# Server Configuration
# Port the server will listen on
PORT=3000

# Host address the server will bind to (0.0.0.0 allows external access)
HOST=0.0.0.0

# Node environment (development, production, test)
NODE_ENV=development

# CORS Configuration
# Allowed origins for CORS requests (comma-separated or * for all)
# Example: https://example.com,https://app.example.com
CORS_ORIGINS=*

# Socket.IO Configuration
# Allowed origins for Socket.IO connections (comma-separated or * for all)
# Should match CORS_ORIGINS in most cases
SOCKET_ALLOWED_ORIGINS=*

# Data Storage
# Directory path for JSON data storage (workflows, roles, prompts, settings)
# Defaults to ./server/data if not specified
# For Railway/Render: Use /app/server/data when mounting persistent volumes
DATA_DIR=./server/data

# Public URLs (for deployment)
# Base URL of your deployed API (used for client configuration)
# Example: https://your-app.railway.app or https://your-app.onrender.com
PUBLIC_API_URL=http://localhost:3000

# WebSocket URL (usually same as API URL but with ws:// or wss://)
# Example: wss://your-app.railway.app
PUBLIC_SOCKET_URL=http://localhost:3000
