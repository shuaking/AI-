# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration (Backend Server)
# Replace * with a comma-separated list of allowed origins in production
CORS_ORIGINS=*
SOCKET_ALLOWED_ORIGINS=*

# Data Storage Configuration
# Configure where JSON data files will be stored (must be writable)
DATA_DIR=/app/server/data

# Frontend Runtime Configuration
# Used when generating public/runtime-config.js for deployments
PUBLIC_API_URL=https://your-api.com
PUBLIC_SOCKET_URL=https://your-api.com
