# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration (Backend Server)
# For single origin:
# CORS_ORIGINS=https://your-frontend.vercel.app
# For multiple origins (comma-separated):
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app
CORS_ORIGINS=*

# Socket.IO CORS Configuration (Optional, defaults to CORS_ORIGINS)
# SOCKET_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Frontend Build Configuration
# These are used when running `npm run build:frontend`
# PUBLIC_API_URL=https://your-backend-api.com
# PUBLIC_SOCKET_URL=https://your-backend-api.com
